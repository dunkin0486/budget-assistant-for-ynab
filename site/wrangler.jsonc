{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Deliberately a separate, minimal Worker from the one at the repo root --
  // no src, no KV/Durable Object bindings, nothing but static files. Keeps
  // this companion site fully isolated from the actual MCP server/OAuth
  // provider, so it can never touch OAUTH_KV or the live token store.
  "name": "plan-assistant-for-ynab-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "."
  }
}
