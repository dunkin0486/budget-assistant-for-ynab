# Copy to .dev.vars for local `wrangler dev` (gitignored -- never commit
# the real values). In production, set these with `wrangler secret put`
# instead, per README.md.

YNAB_CLIENT_ID=your-ynab-oauth-client-id
YNAB_CLIENT_SECRET=your-ynab-oauth-client-secret
# Must exactly match one of the redirect URIs registered with YNAB.
YNAB_REDIRECT_URI=http://localhost:8787/callback
