{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Renamed from "budget-assistant-for-ynab" to match YNAB's own shift from
  // "budget" to "plan" terminology (API v1.79.0, March 2026) -- see
  // docs/ynab-guidelines-and-oauth.md. Renaming a Worker's `name` here
  // deploys it as a *new* Worker at a new *.workers.dev URL; the old
  // "budget-assistant-for-ynab" Worker needs deleting from the dashboard
  // once this is confirmed live, and YNAB_REDIRECT_URI (both the secret
  // here and the redirect URI registered with YNAB) needs updating to
  // match -- see README.md.
  "name": "plan-assistant-for-ynab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Durable Object that backs each authenticated MCP session (holds the
  // live YNAB token pair via McpAgent's props/storage). See
  // docs/hosting-options.md and docs/tool-design-patterns.md for why this
  // is a Durable Object and not Workers KV.
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "PlanAssistantMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlanAssistantMCP"] }],

  // Required by @cloudflare/workers-oauth-provider for its own grant/token
  // storage (the downstream token WE issue to Claude, not the upstream
  // YNAB token). Managed by OpenTofu (infra/kv.tf), applied via
  // .github/workflows/opentofu.yml -- this id is that resource's output,
  // pasted in manually per infra/README.md.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "4b85ab1f1b7e4aea8ea10d530b6738f3"
    }
  ],

  // Non-secret config. Points at the companion site (site/, deployed by
  // .github/workflows/deploy-site.yml as its own isolated Worker -- see
  // site/wrangler.jsonc). Using the clean URLs (no .html) since the
  // asset Worker 307-redirects the extensioned path to this one anyway.
  "vars": {
    "PRIVACY_POLICY_URL": "https://plan-assistant-for-ynab-site.dunkin0486.workers.dev/privacy-policy",
    "TERMS_URL": "https://plan-assistant-for-ynab-site.dunkin0486.workers.dev/terms-of-service"
  },

  "observability": {
    "logs": {
      "enabled": true
      // Matches docs/privacy-policy.md's "7 days at most" log retention
      // commitment -- Workers Logs retention is fixed at 7 days (not
      // currently configurable) on both Free and Paid Cloudflare plans,
      // so no dashboard setting is needed to satisfy this. Code in this
      // project deliberately never logs request/response bodies -- see
      // src/ynab-client.ts.
    }
  }
}
