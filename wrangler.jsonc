{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Renamed from "budget-assistant-for-ynab" to match YNAB's own shift from
  // "budget" to "plan" terminology (API v1.79.0, March 2026) -- see
  // docs/ynab-guidelines-and-oauth.md. The "-worker" suffix (rather than
  // plain "plan-assistant-for-ynab") frees up the unsuffixed name for the
  // companion site (site/wrangler.jsonc), which is the more natural
  // *.workers.dev URL for a human to land on. Renaming a Worker's `name`
  // here deploys it as a *new* Worker at a new *.workers.dev URL -- the
  // old Worker needs deleting from the dashboard once this is confirmed
  // live. YNAB_CLIENT_ID/YNAB_CLIENT_SECRET Worker secrets are set
  // automatically on every deploy by .github/workflows/deploy.yml (from
  // GitHub repo secrets of the same name) specifically so a rename like
  // this doesn't silently leave a new Worker without them again. The
  // YNAB_REDIRECT_URI var below and the redirect URI registered with
  // YNAB's OAuth app both still need updating by hand to match.
  "name": "plan-assistant-for-ynab-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Durable Object that backs each authenticated MCP session (holds the
  // live YNAB token pair via McpAgent's props/storage). See
  // docs/hosting-options.md and docs/tool-design-patterns.md for why this
  // is a Durable Object and not Workers KV.
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "PlanAssistantMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlanAssistantMCP"] }],

  // Required by @cloudflare/workers-oauth-provider for its own grant/token
  // storage (the downstream token WE issue to Claude, not the upstream
  // YNAB token). Managed by OpenTofu (infra/kv.tf), applied via
  // .github/workflows/opentofu.yml -- this id is that resource's output,
  // pasted in manually per infra/README.md.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "4b85ab1f1b7e4aea8ea10d530b6738f3"
    }
  ],

  // Non-secret config. PRIVACY_POLICY_URL/TERMS_URL point at the companion
  // site (site/, deployed by .github/workflows/deploy-site.yml as its own
  // isolated Worker -- see site/wrangler.jsonc); clean URLs (no .html)
  // since the asset Worker 307-redirects the extensioned path to this one
  // anyway. YNAB_REDIRECT_URI lives here rather than as a Worker secret --
  // it isn't actually sensitive (it's a public URL, visible in YNAB's own
  // OAuth app settings), so there's no reason to keep it out of git the
  // way YNAB_CLIENT_ID/SECRET need to be. Must stay in sync with the
  // redirect URI registered in YNAB's OAuth app settings -- update both
  // together.
  "vars": {
    "PRIVACY_POLICY_URL": "https://plan-assistant-for-ynab.dunkin0486.workers.dev/privacy-policy",
    "TERMS_URL": "https://plan-assistant-for-ynab.dunkin0486.workers.dev/terms-of-service",
    "YNAB_REDIRECT_URI": "https://plan-assistant-for-ynab-worker.dunkin0486.workers.dev/callback"
  },

  "observability": {
    "logs": {
      "enabled": true
      // Matches docs/privacy-policy.md's "7 days at most" log retention
      // commitment -- Workers Logs retention is fixed at 7 days (not
      // currently configurable) on both Free and Paid Cloudflare plans,
      // so no dashboard setting is needed to satisfy this. Code in this
      // project deliberately never logs request/response bodies -- see
      // src/ynab-client.ts.
    }
  }
}
